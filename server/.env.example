# Variables à définir dans Render → service dialaw-tv-api → Environment.
# Ne jamais mettre les vraies valeurs dans Git ni dans l'application mobile.

# Neon → Dashboard → Connect → chaîne de connexion (avec ?sslmode=require).
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Wave Business → Développeurs → Clés API (clé avec le droit « Checkout API »).
WAVE_API_KEY=wave_sn_prod_xxxxxxxxxxxxxxxx

# Wave Business → Développeurs → Webhooks → secret affiché à la création du webhook.
WAVE_WEBHOOK_SECRET=wave_sn_WHS_xxxxxxxxxxxxxxxx

# Facultatif : Render fournit déjà son adresse (RENDER_EXTERNAL_URL). À définir
# seulement avec un nom de domaine personnalisé.
# PUBLIC_URL=https://api.dialawtv.sn
